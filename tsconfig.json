{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lib/window-system": ["./lib/window-system/index.ts"],
      "@lib/piano-roll": ["./lib/piano-roll/index.tsx"]
    }
  },
  "include": ["src"]
}
